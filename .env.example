# ---------------------------------------------------------------------------
# BoB Sentinel — environment template.  Copy to .env and fill in.
# Never commit .env (it is gitignored); commit only this template.
# ---------------------------------------------------------------------------

# --- Database (PostGIS) ----------------------------------------------------
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bobsentinel
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Overrides the six fields above if set explicitly.
# DATABASE_URL=postgresql+psycopg://sentinel:change-me@db:5432/bobsentinel

# --- Copernicus Data Space Ecosystem (Sentinel-1 SAR) ----------------------
# Free account: https://dataspace.copernicus.eu/  ("Register")
CDSE_USERNAME=
CDSE_PASSWORD=
# Optional: S3 keys (generated in the CDSE dashboard) for high-throughput
# access to /eodata.  These do not expire like OAuth tokens do.
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=

# --- aisstream.io (live AIS over WebSocket) --------------------------------
# Free key: https://aisstream.io/  (sign in with GitHub, then Account)
AISSTREAM_API_KEY=

# --- Global Fishing Watch API v3 -------------------------------------------
# Free non-commercial token: https://globalfishingwatch.org/our-apis/tokens
GFW_API_TOKEN=

# --- Area of interest ------------------------------------------------------
# Bangladesh EEZ (Marine Regions / VLIZ gazetteer MRGID 8481).
AOI_NAME=Bangladesh EEZ
AOI_MRGID=8481
# Coarse bbox used for the aisstream subscription, as min/max degrees.
# The authoritative spatial filter is the EEZ polygon in PostGIS; this bbox is
# only the coarse server-side pre-filter aisstream needs.
AOI_LAT_MIN=20.5
AOI_LAT_MAX=22.8
AOI_LON_MIN=88.0
AOI_LON_MAX=92.7

# --- Fusion / detection tuning --------------------------------------------
# Radius (metres) within which a SAR detection and an interpolated AIS
# position are considered the same vessel.
MATCH_RADIUS_M=500
# Max age (seconds) of the nearest AIS fix either side of the SAR acquisition
# for an interpolated position to be trusted.
MATCH_MAX_GAP_S=1800
# CFAR defaults (see bob_sentinel/sar/cfar.py).
CFAR_PFA=1e-9
CFAR_GUARD=8
CFAR_TRAIN=24

# --- App -------------------------------------------------------------------
LOG_LEVEL=INFO
DATA_DIR=/data
